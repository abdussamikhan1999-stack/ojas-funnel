# Copy the NAMES of these into your Vercel project's Environment Variables.
# Do NOT put real values in the repo — set them in Vercel only.
#
# The Meta Pixel ID is PUBLIC and lives in index.html CONFIG.pixelId — not here.
# These are the SECRET keys used only by api/lead.js and api/deliver.js on the server.

# --- Email service provider (pick one) ---
# Klaviyo
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# --- Or a generic webhook (Zapier/Make/your CRM) ---
LEAD_WEBHOOK_URL=

# --- Meta Conversions API (optional, server-side event dedupe) ---
META_CAPI_TOKEN=
META_PIXEL_ID=

# --- Razorpay (required for api/deliver.js to release the paid protocol) ---
# Dashboard -> Settings -> API Keys -> "Key Secret" (NOT the public Key ID,
# which doesn't go here — see SETUP.md for where the public Key ID/payment
# link itself is configured). Used to verify the signed redirect Razorpay
# sends back after a real payment, before releasing the paid content.
RAZORPAY_KEY_SECRET=
